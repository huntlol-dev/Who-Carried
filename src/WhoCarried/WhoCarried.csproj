<Project Sdk="Microsoft.NET.Sdk">
  <!-- Machine-specific settings (e.g. GameDir) live in the untracked local.props at the repo root. -->
  <Import Project="..\..\local.props" Condition="Exists('..\..\local.props')" />
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WhoCarried</AssemblyName>
    <RootNamespace>WhoCarried</RootNamespace>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>portable</DebugType>
    <!-- Pass -p:GameData=<folder of the game's DLLs> to build against another game version's files. -->
    <GameData Condition="'$(GameData)' == ''">$(GameDir)\data_sts2_windows_x86_64</GameData>
    <!-- The version lives in WhoCarried.json, the manifest the game reads; the assembly (and the mod's log) take it from there. -->
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)WhoCarried.json')), '(?s)^.*?"version"\s*:\s*"([^"]+)".*$', '$1'))</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <!-- The game's DLLs are referenced in place, so the build has to know where the game is installed. -->
  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(GameData)\sts2.dll')">
    <Error Text="Can't find the game's DLLs in '$(GameData)'. Set GameDir in local.props (copy local.props.example) or pass -p:GameDir=&lt;your Slay the Spire 2 folder&gt;." />
  </Target>
  <ItemGroup>
    <InternalsVisibleTo Include="WhoCarried.CardCreationChecks" />
    <Reference Include="sts2">
      <HintPath>$(GameData)\sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameData)\GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameData)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Steamworks.NET">
      <HintPath>$(GameData)\Steamworks.NET.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <None Include="WhoCarried.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="UI\Art\TopBarIcon.svg" LogicalName="WhoCarried.TopBarIcon.svg" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/**/*.json" LogicalName="WhoCarried.Localization.%(Filename).json" />
  </ItemGroup>
</Project>
